{% extends 'base.html.twig' %}

{% block title %}Galerie de Photos{% endblock %}

{% block body %}
    <h1 class="text-center mb-4">Galerie de Photos</h1>

    <div class="container">
        <div class="row">
            {% for photo in photos %}
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm">
                        <img src="{{ asset('uploads/photos/' ~ photo.filename) }}" class="card-img-top" alt="Photo">
                        <div class="card-body">
                            <p class="card-text text-center">{{ photo.title }}</p>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <p class="text-center">Aucune photo à afficher.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
